{
  "tags": {
    "description": "hammerdb-remotehosts-client-only-example"
  },
  "endpoints": [
    {
      "type": "remotehosts",
      "settings": {
        "user": "REPLACE_WITH_ENGINE_USER",
        "controller-ip-address": "192.0.2.1"
      },
      "remotes": [
        {
          "engines": [
            { "role": "client", "ids": [1] }
          ],
          "config": {
            "host": "hammerdb-client.example.invalid",
            "settings": {
              "userenv": "alma9",
              "osruntime": "podman",
              "cpu-partitioning": false,
              "host-mounts": [
                { "src": "/REPLACE_WITH_DATA_MOUNT", "dest": "/mnt/hammerdb-data" },
                { "src": "/REPLACE_WITH_LOG_MOUNT", "dest": "/mnt/hammerdb-logs" }
              ]
            }
          }
        }
      ]
    }
  ],
  "benchmarks": [
    {
      "name": "hammerdb",
      "ids": "1",
      "mv-params": {
        "sets": [
          {
            "params": [
              { "arg": "backend", "vals": ["mariadb"] },
              { "arg": "warehouses", "vals": ["1"] },
              { "arg": "virtual-users", "vals": ["2"] },
              { "arg": "rampup-minutes", "vals": ["1"] },
              { "arg": "duration-minutes", "vals": ["1"] },
              { "arg": "data-dir", "vals": ["/mnt/hammerdb-data"] },
              { "arg": "log-dir", "vals": ["/mnt/hammerdb-logs"] }
            ]
          }
        ]
      }
    }
  ],
  "run-params": {
    "num-samples": 1,
    "test-order": "sample"
  },
  "tool-params": []
}
